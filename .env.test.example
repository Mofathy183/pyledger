# Copy this file to .env.test before running the test suite.
#
# Tests should use a dedicated database and must never share the
# application's development database.

PYLEDGER_TEST_MONGO__URI=mongodb://localhost:27017
PYLEDGER_TEST_MONGO__DB=pyledger_test

PYLEDGER_TEST_MONGO__SERVER_SELECTION_TIMEOUT_MS=5000

PYLEDGER_TEST_MONGO__MIN_POOL_SIZE=1

PYLEDGER_TEST_MONGO__RETRY_READS=true
PYLEDGER_TEST_MONGO__RETRY_WRITES=true