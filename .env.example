# Copy this file to .env and adjust the values for your local environment.
#
# MongoDB connection settings used by the application.

PYLEDGER_MONGO__URI=mongodb://localhost:27017
PYLEDGER_MONGO__DB=pyledger

PYLEDGER_MONGO__SERVER_SELECTION_TIMEOUT_MS=5000

PYLEDGER_MONGO__MIN_POOL_SIZE=1

PYLEDGER_MONGO__RETRY_READS=true
PYLEDGER_MONGO__RETRY_WRITES=true

PYLEDGER_API__HOST=127.0.0.1
PYLEDGER_API__PORT=8000
PYLEDGER_API__RELOAD=true