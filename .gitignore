.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Documentation
docs/_build/

# Jupyter Notebook
.ipynb_checkpoints

# UV
#   Similar to Pipfile.lock, it is generally recommended to include uv.lock in version control.
#   For applications (like this project), KEEP uv.lock tracked for reproducibility.
# uv.lock

# PEP 582 (rare, but safe to ignore)
__pypackages__/

